#!/bin/sh
# Update Formula/kiseki.rb from a published Kiseki Terminal v2 GitHub Release.
set -eu

repo=nerv-base/kiseki-terminal
formula=Formula/kiseki.rb

if [ -n "${1:-}" ]; then
  tag="$1"
else
  tag=$(gh api "repos/$repo/releases" \
    --jq '[.[] | select(.draft == false and (.tag_name | startswith("v2.")))][0].tag_name // empty')
fi

if [ -z "$tag" ]; then
  echo "no published v2 release found in $repo" >&2
  exit 1
fi

version=${tag#v}
case "$version" in
  ''|*[!0-9A-Za-z.-]*)
    echo "invalid release tag: $tag" >&2
    exit 1
    ;;
esac

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT INT TERM

gh release download "$tag" --repo "$repo" --pattern "kiseki.rb" --output "$tmp" --clobber
ruby -c "$tmp" >/dev/null

if ! grep -q "^  version \"$version\"$" "$tmp"; then
  echo "downloaded kiseki.rb does not match version $version" >&2
  exit 1
fi

mkdir -p "$(dirname "$formula")"
cp "$tmp" "$formula"
echo "kiseki $version ($formula updated)"
